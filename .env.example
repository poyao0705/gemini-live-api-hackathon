# Application settings — copy to .env and fill in your values

# Gemini model to use for the demo agent
DEMO_AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# PostgreSQL database connection URL (overrides individual POSTGRES_* settings below)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_ECHO=false

# PostgreSQL connection details (used when DATABASE_URL is not set)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Gmail API settings
GMAIL_USER_ID=me
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Google Cloud Pub/Sub topic for Gmail push notifications
# e.g. projects/my-project/topics/gmail-push
GMAIL_WATCH_TOPIC=

# Comma-separated Gmail label IDs to watch (default: INBOX)
GMAIL_WATCH_LABEL_IDS_CSV=INBOX

# Comma-separated list of email addresses to process (leave empty to allow all)
GMAIL_ALLOWED_EMAIL_ADDRESSES_CSV=

# Recall AI settings
# API token for authenticating with the Recall AI REST API
RECALL_AI_TOKEN=
# Base URL for the Recall AI API (region-specific)
RECALL_AI_BASE_URL=https://ap-northeast-1.recall.ai/api/v1
# Display name used for the bot that joins meetings
RECALL_AI_BOT_NAME=Gemini Agent
